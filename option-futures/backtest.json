 "strategy": [
  {
   "section": "Overview",
   "item": "Name",
   "detail": "Option + Futures (variant G + 50 pt stop)"
  },
  {
   "section": "Overview",
   "item": "Idea",
   "detail": "Trade the ORB15+CPR breakout direction only when NIFTY futures show fresh OI build-up on the same side."
  },
  {
   "section": "Overview",
   "item": "Instrument traded",
   "detail": "NIFTY weekly ATM option: BUY CALL (CE) on a long signal, BUY PUT (PE) on a short signal. 1 lot. Option buying only, no selling."
  },
  {
   "section": "Overview",
   "item": "Signal inputs",
   "detail": "1) NIFTY spot 1-min (index, Dhan id 13)  2) NIFTY front-month futures 1-min price + open interest  3) NIFTY previous-day daily high/low/close"
  },
  {
   "section": "Overview",
   "item": "Decision grid",
   "detail": "Every 3 minutes on bar close, from 09:33 to 15:24 IST"
  },
  {
   "section": "Levels",
   "item": "Opening range (OR15)",
   "detail": "High and low of NIFTY spot from 09:15 to 09:29 (first 15 one-minute bars)"
  },
  {
   "section": "Levels",
   "item": "CPR pivot P",
   "detail": "(prev high + prev low + prev close) / 3"
  },
  {
   "section": "Levels",
   "item": "CPR BC",
   "detail": "(prev high + prev low) / 2, then swapped with TC if larger"
  },
  {
   "section": "Levels",
   "item": "CPR TC",
   "detail": "2 x P - BC  (TC = the higher of the two, BC = the lower)"
  },
  {
   "section": "Option vote",
   "item": "ORB15+CPR = CE",
   "detail": "Spot close > OR15 high AND spot close > CPR TC"
  },
  {
   "section": "Option vote",
   "item": "ORB15+CPR = PE",
   "detail": "Spot close < OR15 low AND spot close < CPR BC"
  },
  {
   "section": "Option vote",
   "item": "ORB15+CPR = flat",
   "detail": "Anything else (inside the opening range or inside/on the wrong side of CPR)"
  },
  {
   "section": "Futures vote",
   "item": "Bars",
   "detail": "Futures bars of 3, 5, 15 and 60 minutes, anchored at 09:15. Only CLOSED bars are used."
  },
  {
   "section": "Futures vote",
   "item": "Per bar",
   "detail": "d_price = bar close - bar open;  d_OI = OI at bar end - OI at previous bar end"
  },
  {
   "section": "Futures vote",
   "item": "LONG BUILDUP",
   "detail": "d_price >= 0 and d_OI > 0  ->  +1 (fresh longs)"
  },
  {
   "section": "Futures vote",
   "item": "SHORT COVERING",
   "detail": "d_price >= 0 and d_OI <= 0  ->  0 in the build-up count (+1 in the MTF score)"
  },
  {
   "section": "Futures vote",
   "item": "SHORT BUILDUP",
   "detail": "d_price < 0 and d_OI > 0  ->  -1 (fresh shorts)"
  },
  {
   "section": "Futures vote",
   "item": "LONG UNWINDING",
   "detail": "d_price < 0 and d_OI <= 0  ->  0 in the build-up count (-1 in the MTF score)"
  },
  {
   "section": "Futures vote",
   "item": "OI build-up score",
   "detail": "Sum over the 4 timeframes of the latest closed bar: range -4..+4. Used by this rule."
  },
  {
   "section": "Futures vote",
   "item": "MTF score (info only)",
   "detail": "Nifty Futures project score: +1 if price up, -1 if down, per TF (ignores OI). Range -4..+4. Shown on charts, not used for entry."
  },
  {
   "section": "Entry",
   "item": "BUY CALL",
   "detail": "ORB15+CPR = CE AND OI build-up score >= +1, and no position open, and time before 15:10"
  },
  {
   "section": "Entry",
   "item": "BUY PUT",
   "detail": "ORB15+CPR = PE AND OI build-up score <= -1, and no position open, and time before 15:10"
  },
  {
   "section": "Entry",
   "item": "Strike",
   "detail": "ATM = spot rounded to nearest 50, nearest weekly expiry"
  },
  {
   "section": "Entry",
   "item": "Fill",
   "detail": "At the 3-min bar close that produced the signal"
  },
  {
   "section": "Exit",
   "item": "Reversal",
   "detail": "Exit when ORB15+CPR flips to the opposite side (CE held -> PE signal, or PE held -> CE signal)"
  },
  {
   "section": "Exit",
   "item": "Stop-loss",
   "detail": "Exit when NIFTY spot closes (3-min) 50 pts against the entry spot: CE if spot <= entry - 50, PE if spot >= entry + 50. On the option this is roughly 25 premium pts for an ATM (delta ~0.5). Checked on 3-min closes, so fills can be past the level."
  },
  {
   "section": "Exit",
   "item": "End of day",
   "detail": "Square off at 15:24 (last 3-min decision before 15:25). 28 of 55 trades exited here."
  },
  {
   "section": "Exit",
   "item": "Target / trailing",
   "detail": "NONE. No target, no trailing stop."
  },
  {
   "section": "Exit",
   "item": "Re-entry",
   "detail": "Allowed same day after an ORB15+CPR flip, or on the opposite side. After a stop-loss, NO re-entry on the same side that day."
  },
  {
   "section": "Risk",
   "item": "Position size",
   "detail": "1 lot, one position at a time"
  },
  {
   "section": "Risk",
   "item": "Cost assumed",
   "detail": "4.0 NIFTY points per round trip (spread + charges + slippage)"
  },
  {
   "section": "Backtest",
   "item": "Period",
   "detail": "2026-08-26 to 2026-11-19 (58 sessions)"
  },
  {
   "section": "Backtest",
   "item": "Data source",
   "detail": "Dhan /v2/charts/intraday 1-min: NIFTY index + NIFTY NOV FUT (id 61471) with OI; /v2/charts/historical daily for CPR"
  },
  {
   "section": "Backtest",
   "item": "P&L unit",
   "detail": "NIFTY spot points (direction proxy for an ATM option at delta ~0.5). Real option P&L differs: theta decay over an all-day hold makes it worse."
  },
  {
   "section": "Backtest",
   "item": "Split test",
   "detail": "First half (to 07 Oct) and second half (from 08 Oct) reported separately"
  },
  {
   "section": "Caveats",
   "item": "Significance",
   "detail": "t-stat 1.51: NOT statistically significant. First half net -191 pts."
  },
  {
   "section": "Caveats",
   "item": "Stop choice",
   "detail": "Stop size picked after testing 30/40/50/60/75/100 (sheet Stop sweep). 40-60 all give similar results, so 50 is not a lucky single value."
  },
  {
   "section": "Caveats",
   "item": "Futures data",
   "detail": "Only live futures contracts have history on Dhan. NOV FUT was the next-month contract before 28 Oct, so early OI changes come from a thinner contract."
  },
  {
   "section": "Caveats",
   "item": "Holding pattern",
   "detail": "Most trades pick a side in the first hour and hold to 15:24. Without a stop, reversal days ran all day against the trade (11 Nov -274); the stop caps that."
  },
  {
   "section": "Caveats",
   "item": "Futures/OC exits",
   "detail": "Exiting on futures OI build-up against, futures score against or option-chain PCR was tested (sheet Exit research): they fire on winners too and did worse or no better than the plain spot stop."
  },
  {
   "section": "Live",
   "item": "Dashboard",
   "detail": "aps-source.github.io/option-futures replays today's signals with this rule (entry, stop, flip, 15:24) and shows the open position and its stop level."
  },
  {
   "section": "Files",
   "item": "Code",
   "detail": "backtest.py (rules, variants A-I), exits.py (exit research), trade_charts.py [stop] (this workbook + 4K charts), chart_4k.py [stop] (overview), suggest.py"
  }
 ],
